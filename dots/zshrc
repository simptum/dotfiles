    echo "This function is not in use!"
    return 1
    pandoc input.md -o output.pdf \
  --pdf-engine=xelatex \
  -V geometry:margin=0.5in
}

sudo() {
  if [[ "$1" == "vim" ]]; then
    if [[ "$#" -gt 2 ]]; then
      echo "sudo vim: only one file at a time, please."
      return 1
    fi

    if [[ -z "$2" ]]; then
      echo "sudo vim: no file specified."
      return 1
    fi

    local original="$2"
    local tmpfile="/tmp/sudovim_$(basename "$original")_$$"

    # Create tmpfile
    if ! is_valid=$(sudo stat -c "%a" "$original" &> /dev/null); then
      command sudo touch "$original"
    fi

    command sudo cp "$original" "$tmpfile"
    command sudo chown "$USER" "$tmpfile"

    vim "$tmpfile"

    # Copy tmpfile to original
    command sudo cp "$tmpfile" "$original"
    command sudo rm "$tmpfile"

  else
    command sudo "$@"
  fi
}

unlock() {
    eval $(bw unlock | sed -n '/export/s/^[^[:space:]]*[[:space:]]*//p')
}

lock() {
    bw lock
}

PATH=$PATH:$HOME/.local/bin

source <(kubectl completion zsh)

eval "$(starship init zsh)"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
